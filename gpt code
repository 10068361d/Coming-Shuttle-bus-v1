const getNextBuses = (schedule) => {
  const now = new Date();
  const currentMinutes = now.getHours() * 60 + now.getMinutes();

  return schedule
    .map(time => {
      const h = parseInt(time.substring(0, 2));
      const m = parseInt(time.substring(2));
      return h * 60 + m;
    })
    .filter(min => min >= currentMinutes)
    .slice(0, 3)
    .map(min => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`);
};

export default function ShuttleSchedule() {
  const [nextStation1, setNextStation1] = useState([]);
  const [nextStation2, setNextStation2] = useState([]);

  useEffect(() => {
    const update = () => {
      setNextStation1(getNextBuses(station1Times));
      setNextStation2(getNextBuses(station2Times));
    };

    update();
    const interval = setInterval(update, 60000);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="p-4 max-w-xl mx-auto space-y-6">
      <h1 className="text-2xl font-bold text-center">Shuttle Bus Schedule</h1>

      <Card>
        <CardContent className="p-4">
          <h2 className="text-xl font-semibold mb-2">Station 1 - Next Buses</h2>
          <ul className="space-y-1">
            {nextStation1.map((time, idx) => (
              <li key={idx}>{time}</li>
            ))}
          </ul>
        </CardContent>
      </Card>

      <Card>
        <CardContent className="p-4">
          <h2 className="text-xl font-semibold mb-2">Station 2 - Next Buses</h2>
          <ul className="space-y-1">
            {nextStation2.map((time, idx) => (
              <li key={idx}>{time}</li>
            ))}
          </ul>
        </CardContent>
      </Card>
    </div>
  );
}
